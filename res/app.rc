#include <windows.h>

// Manifest: privilegi di amministratore + Common Controls 6 + DPI aware
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Icona dell'applicazione (logo)
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "FileDescription", "DnsSwitch - cambio e test DNS"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "DnsSwitch"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "DnsSwitch.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
